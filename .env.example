# Copy this file to .env and fill in real values before running in anything but local dev.

# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Where the SQLite database file is stored.
DATABASE_PATH=./data/lalco.db

# Port the server listens on. On a container platform this is injected.
PORT=4000

# Interface to bind. Must be 0.0.0.0 in a container, or the platform cannot
# route to it. Leave as-is unless you know you need otherwise.
HOST=0.0.0.0

# Used to build the exam link shown to admins (e.g. https://recruit.lalco.la).
# Falls back to the request's own host if not set.
PUBLIC_EXAM_BASE_URL=

# Restrict CORS to your real admin frontend origin in production, e.g. https://recruit.lalco.la
CORS_ORIGIN=

# Password given to the seeded admin accounts (see `npm run seed`).
# REQUIRED — there is no built-in default, and the seed refuses weak or
# publicly known values. Must meet the same policy as an admin password
# reset: at least 14 characters using 3 of lowercase/uppercase/digit/symbol.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
DEMO_PASSWORD=

NODE_ENV=development

# ---------------------------------------------------------------------------
# Google Sheets — HR reporting / export destination only.
# SQLite remains the source of truth. If these are unset, the app runs exactly
# as before and the sync buttons report "not configured" instead of failing.
# These values are read server-side only and are never sent to a browser.
# ---------------------------------------------------------------------------

# The spreadsheet the HR reporting workbook is written into.
GOOGLE_SHEET_ID=

# Service account that has edit access to that spreadsheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The service account's private key. Keep the \n escapes on one line, e.g.
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# true = try to sync each assessment to Google Sheets right after submission.
# The sync runs after the response is sent and can never fail or delay an exam;
# anything that does not reach Google is left as google_sync_status = PENDING
# for the administrator's "RETRY GOOGLE SHEETS SYNC" button.
GOOGLE_SYNC_ON_SUBMIT=false

# true = include is_demo candidates in the HR workbook. Leave false in production
# so test data never mixes with real reporting.
GOOGLE_SYNC_INCLUDE_DEMO=false

# ---------------------------------------------------------------------------
# Rate limiting / transport
# ---------------------------------------------------------------------------

# Per-IP ceiling on public exam requests per minute (minimum 60, default 300).
# Must stay well above real traffic: answers autosave while a candidate types,
# and candidates sitting in one office share a public IP.
EXAM_RATE_LIMIT_PER_MINUTE=300

# Per-IP admin login attempts per 15 minutes (minimum 5, default 20).
LOGIN_RATE_LIMIT_PER_15_MIN=20

# With NODE_ENV=production the server redirects plain HTTP to HTTPS, refuses
# non-GET requests over plain HTTP, and sends HSTS. Set this to true ONLY when
# something in front of it already guarantees TLS and strips the scheme header.
ALLOW_INSECURE_HTTP=false

# ---------------------------------------------------------------------------
# Automatic submission on time expiry
# ---------------------------------------------------------------------------

# How often the server sweeps for assessments whose time ran out while nobody
# was using the browser (candidate walked away, phone asleep). Those are
# finalized as AUTO_SUBMITTED / TIME_EXPIRED. Minimum 5 seconds, default 60.
# Finalization is idempotent, so this can never create a second submission.
AUTO_SUBMIT_SWEEP_SECONDS=60

# ---------------------------------------------------------------------------
# Automatic question translation (optional)
# ---------------------------------------------------------------------------

# Machine translation of candidate-visible question wording (English <-> Lao),
# used ONLY by the admin Question Bank editor when someone presses
# "Auto-translate". Leave it unset and the feature stays switched off: the
# endpoint answers 503 and the admin buttons are disabled with an explanation.
# Nothing else in the platform depends on it, and no candidate route touches it.
#
# The key is read server-side only, in src/lib/translation.js. It is never sent
# to a browser, never written to the database, never logged and never included
# in an error message — the admin UI is told a single boolean.
#
# Provider: the OpenAI Responses API with Structured Outputs (strict JSON
# schema), so the reply cannot come back as prose. The shape is still validated
# again server-side — strict mode guarantees the SHAPE, not that the canonical
# option values were left alone.
#
# Machine output is stored as translation_status=DRAFT with
# translation_source=MACHINE, and a DRAFT is never shown to a candidate. A human
# must read it and set APPROVED before it reaches anyone sitting an assessment.
OPENAI_API_KEY=

# Optional. Model access varies between OpenAI accounts, so if the default
# (gpt-4.1) is not enabled on yours, name one that is instead of editing code.
OPENAI_MODEL=

# Translation requests allowed per admin USER per hour (minimum 5, default 60).
# Keyed by user so several admins behind one office IP do not share a budget.
TRANSLATE_RATE_LIMIT_PER_HOUR=60
